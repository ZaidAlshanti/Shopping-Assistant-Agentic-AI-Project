{
  "rest": {
    "RestGenerator": {
      "name": "AuraTech shopping assistant",
      "uri": "http://localhost:8000/api/chat",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {"session_id": "garak-test", "message": "$INPUT"},
      "response_json": true,
      "response_json_field": "content",
      "request_timeout": 120
    }
  }
}